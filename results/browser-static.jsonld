      {
        "@type": "Recipe",
        "@id": "https://poc-json-ld.pages.dev/#recipe",
        "name": "Tortilla de patatas clásica",
        "description": "Tortilla de patatas española jugosa, con cebolla pochada y huevos batidos, cuajada lentamente en sartén.",
        "image": [
          "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Tortilla_de_patatas.jpg/1280px-Tortilla_de_patatas.jpg"
        ],
        "author": {
          "@type": "Person",
          "name": "María López"
        },
        "datePublished": "2026-02-10",
        "inLanguage": "es-ES",
        "prepTime": "PT20M",
        "cookTime": "PT30M",
        "totalTime": "PT50M",
        "recipeYield": "4 raciones",
        "recipeCategory": "Plato principal",
        "recipeCuisine": "Española",
        "keywords": "tortilla de patatas, tortilla española, receta tradicional, huevos, patatas, cebolla",
        "recipeIngredient": [
          "6 huevos grandes",
          "800 g de patatas",
          "1 cebolla mediana",
          "200 ml de aceite de oliva virgen extra",
          "Sal al gusto"
        ],
        "recipeInstructions": [
          {
            "@type": "HowToStep",
            "position": 1,
            "name": "Pelar y cortar",
            "text": "Pela las patatas y córtalas en láminas finas de unos 3 mm. Corta la cebolla en juliana."
          },
          {
            "@type": "HowToStep",
            "position": 2,
            "name": "Pochar en aceite",
            "text": "Calienta el aceite en una sartén y pocha la cebolla a fuego medio durante 10 minutos. Añade las patatas y cocina 15 minutos más hasta que estén tiernas."
          },
          {
            "@type": "HowToStep",
            "position": 3,
            "name": "Batir los huevos",
            "text": "Bate los huevos con una pizca de sal en un bol grande. Escurre las patatas y la cebolla y mézclalas con el huevo batido. Deja reposar 5 minutos."
          },
          {
            "@type": "HowToStep",
            "position": 4,
            "name": "Cuajar la tortilla",
            "text": "Vierte la mezcla en una sartén antiadherente con un poco de aceite y cuaja a fuego medio-bajo, 4 minutos por cada lado."
          },
          {
            "@type": "HowToStep",
            "position": 5,
            "name": "Reposar y servir",
            "text": "Deja reposar la tortilla 5 minutos antes de servir para que asiente. Sirve templada o a temperatura ambiente."
          }
        ],
        "nutrition": {
          "@type": "NutritionInformation",
